server:
  host: 0.0.0.0
  port: 4000
  master_key: sk-your-litellm-key
  telemetry: false

general_settings:
  timeout: 120
  store: false

model_list:
  # --- Google AI Studio (Gemini) ---
  - model_name: gemini-2.0-flash-lite
    litellm_params:
      model: gemini/gemini-2.0-flash-lite
      api_key: GEMINI_API_KEY
  - model_name: gemini-2.5-flash-lite
    litellm_params:
      model: gemini/gemini-2.5-flash-lite
      api_key: GEMINI_API_KEY

  # --- xAI (Grok) ---
  - model_name: grok-3-mini
    litellm_params:
      model: xai/grok-3-mini
      api_key: XAI_API_KEY

  # --- Anthropic ---
  - model_name: claude-haiku-3
    litellm_params:
      model: anthropic/claude-3-haiku-20240307
      api_key: ANTHROPIC_API_KEY

  # --- Alibaba DashScope (Qwen) ---
  - model_name: qwen-flash
    litellm_params:
      model: dashscope/qwen-flash
      api_key: DASHSCOPE_API_KEY

  # --- DeepSeek ---
  - model_name: deepseek-chat
    litellm_params:
      model: deepseek/deepseek-chat
      api_key: DEEPSEEK_API_KEY

  # =======================
  # Google Vertex AI 제공 모델
  # =======================
  - model_name: mistral-small-2503@vertex
    litellm_params:
      model: vertex_ai/mistral-small-2503
      vertex_project: GCP_PROJECT_ID
      vertex_location: us-central1

  - model_name: llama-4-scout-17b@vertex
    litellm_params:
      model: vertex_ai/meta/llama-4-scout-17b-16e-instruct-maas
      vertex_project: GCP_PROJECT_ID
      vertex_location: us-east5
