  { "model": "qwen-flash",                 "api_type": "open_ai", "base_url": "http://host.docker.internal:4000/v1", "api_key": "sk-your-litellm-key" },
  { "model": "deepseek-chat",              "api_type": "open_ai", "base_url": "http://host.docker.internal:4000/v1", "api_key": "sk-your-litellm-key" },

  // ---- Vertex AI 제공 모델 (프록시 → Vertex) ----
